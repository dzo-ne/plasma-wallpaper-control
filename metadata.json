{
    "KPackageStructure": "Plasma/Wallpaper",
    "KPlugin": {
        "Authors": [
            {
                "Email": "dragozeroone@hotmail.com",
                "Name": "DZO"
            }
        ],
        "Category": "Image",
        "Description": "Interactive wallpaper management and precision framing with aspect-ratio cropping, pan, zoom, and multi-surface synchronization",
        "Icon": "transform-crop",
        "Id": "org.kde.plasma.cropwallpaper",
        "License": "GPL-3.0-or-later",
        "MimeTypes": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/avif",
            "image/bmp",
            "image/svg+xml"
        ],
        "Name": "Wallpaper Control",
        "Version": "1.1.0",
        "Website": "https://github.com/dzo-ne/plasma-wallpaper-control"
    },
    "X-KDE-ParentApp": "org.kde.plasmashell",
    "X-Plasma-DropMimeTypes": [
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/avif",
        "image/bmp",
        "image/svg+xml"
    ]
}
